#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Alternate ArchR UI session; runemu.sh retains ownership of game hotkeys.

# ArchR's /etc/profile contains Bash functions and loads device/user quirks.
# Source it in Bash once, then replace that process with this POSIX supervisor.
# Before the UI, do what es_settings did for EmulationStation: apply timezone
# and language (archr-apply-locale) and hand the quirk exports to systemd so
# units started later see them. Both are optional and neither may block the
# UI: when the configured locale is not generated yet, archr-apply-locale
# (which would run localedef for minutes) is detached at idle priority. The
# launcher translates itself; the libc locale only matters to later children.
if [ "${1-}" != --profile-loaded ]; then
    profile=/etc/profile
    session_shell=/bin/sh
    apply_locale=/usr/bin/archr-apply-locale
    quirk_exports=/etc/profile.d/999-export
    locale_dir=/usr/lib/locale
    if [ "${ARCHR_SESSION_TEST:-0}" = 1 ]; then
        profile=${ARCHR_SESSION_PROFILE:?}
        session_shell=${ARCHR_SESSION_SHELL:?}
        apply_locale=${ARCHR_SESSION_APPLY_LOCALE:?}
        quirk_exports=${ARCHR_SESSION_EXPORTS:?}
        locale_dir=${ARCHR_SESSION_LOCALE_DIR:?}
    fi
    exec /usr/bin/bash -c '
        . "$1"
        locale=$(get_setting system.language)
        if [ ! -x "$4" ]; then
            :
        elif [ -z "$locale" ] || [ -e "$6/$locale.UTF-8/LC_NAME" ]; then
            "$4" >/dev/null || echo "archr-launcher-session: $4 failed" >&2
        elif command -v systemd-run >/dev/null 2>&1; then
            # Own unit: survives session restarts; its fixed name keeps a
            # single instance (a second start fails while one is active).
            timeout -k 1 5 systemd-run --no-block --collect --quiet \
                --unit=archr-apply-locale --nice=19 -p IOSchedulingClass=idle \
                "$4" >/dev/null 2>&1 || :
        else
            nice -n 19 "$4" >/dev/null 2>&1 </dev/null &
        fi
        if [ -r "$5" ]; then
            names=$(sed "s/#.*//" "$5" | grep -o "[A-Z_][A-Z0-9_]*")
            [ -z "$names" ] || timeout -k 1 5 systemctl import-environment $names || :
        fi
        # Functions such as get_setting do not survive exec into POSIX sh.
        # glibc finds generated locales through /usr/lib/locale; a LOCPATH
        # inherited from the manager may still point at the ES folder.
        unset I18NPATH LOCPATH
        if [ -n "$locale" ]; then
            export LANG="$locale.UTF-8" LANGUAGE="$locale.UTF-8"
        fi
        exec "$2" "$3" --profile-loaded
    ' archr-session "$profile" "$session_shell" "$0" "$apply_locale" "$quirk_exports" \
        "$locale_dir"
fi

run_dir=/run/archr-launcher
launcher=/usr/bin/archr-launcher
log_file=/var/log/archr-launcher-session.log
kill_file=/tmp/.process-kill-data
cpufreq=/sys/devices/system/cpu/cpufreq
save_exit=/usr/bin/archr-game-save-exit
sway_attempts=100
sleep_bin=sleep
stop_sleep=sleep
user_controller_db=/storage/.config/SDL-GameControllerDB/gamecontrollerdb.txt
packaged_controller_db=/usr/config/SDL-GameControllerDB/gamecontrollerdb.txt
error_report=/usr/bin/archr-error-report
# Overrides are only for hermetic host tests, never read in normal operation.
if [ "${ARCHR_SESSION_TEST:-0}" = 1 ]; then
    run_dir=${ARCHR_SESSION_RUN_DIR:?}
    launcher=${ARCHR_SESSION_LAUNCHER:?}
    log_file=${ARCHR_SESSION_LOG:?}
    kill_file=${ARCHR_SESSION_KILL_FILE:?}
    cpufreq=${ARCHR_SESSION_CPUFREQ:?}
    save_exit=${ARCHR_SESSION_SAVE_EXIT:?}
    sway_attempts=${ARCHR_SESSION_SWAY_ATTEMPTS:-100}
    sleep_bin=${ARCHR_SESSION_SLEEP:?}
    stop_sleep=${ARCHR_SESSION_STOP_SLEEP:?}
    user_controller_db=${ARCHR_SESSION_USER_CONTROLLER_DB:?}
    packaged_controller_db=${ARCHR_SESSION_PACKAGED_CONTROLLER_DB:?}
    error_report=${ARCHR_SESSION_ERROR_REPORT:-/nonexistent}
fi

# Same UI exports as 001-functions and 050-sway.conf. Quirk exports already
# arrived through /etc/profile; keep them, including GPU/SDL overrides.
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-1}
export SWAYSOCK=${SWAYSOCK:-$XDG_RUNTIME_DIR/sway-ipc.0.sock}
export SDL_VIDEODRIVER=${SDL_VIDEODRIVER:-wayland}
export SDL_AUDIODRIVER=pulseaudio
# Controller mappings come only from this database. An inherited path wins only
# if the file exists; then the user copy, then the packaged one.
controller_db=${SDL_GAMECONTROLLERCONFIG_FILE-}
[ -n "$controller_db" ] && [ -f "$controller_db" ] || controller_db=$user_controller_db
[ -f "$controller_db" ] || controller_db=$packaged_controller_db
export SDL_GAMECONTROLLERCONFIG_FILE="$controller_db"
export XKB_CONFIG_ROOT=${XKB_CONFIG_ROOT:-/usr/share/X11/xkb}

mkdir -p "$run_dir" || exit 1
chmod 0755 "$run_dir" || exit 1
: >>"$log_file" || exit 1

cap_log() {
    # This file contains supervisor events only. Child output goes to the
    # service's journal (and runemu's exec.log), so a long-running child cannot
    # grow it past the cap between events.
    if [ "$(wc -c <"$log_file")" -ge 262144 ]; then
        : >"$log_file"
    fi
}

session_log() {
    cap_log
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$log_file"
    cap_log
}

child_pid=
child_scope=
gate=
game_started=0
# A TERM while a child is being started or a game cleaned up is only recorded;
# the stop runs at the next safe point.
defer_stop=0
stop_pending=0

# Every manager call is bounded, so a stuck systemd cannot stall the session.
scope_active() {
    timeout -k 0.1 0.5 systemctl is-active --quiet "$1" >/dev/null 2>&1 9>&-
}

# Games run with TimeoutStopSec=1: systemd sends TERM to the whole scope,
# KILL after 1 s, and returns once it is empty (at once if it already is).
stop_scope() {
    timeout -k 0.1 1.3 systemctl stop "$1" >/dev/null 2>&1 9>&- || :
}

# What systemd-run --scope runs: not the game, but a gate in front of it,
# game-gate-<n> for scope archr-game-<n>, so a late gate of an earlier launch
# never reads a newer "go". Anything but its own FIFO ends it. It opens the
# FIFO read-only without blocking (its own read-write descriptor stands in as
# a writer until the second open), so the session's descriptor is the only
# writer left. The game is exec'd, keeping this PID, only after reading "go";
# EOF, because the session closed the gate or died, ends it.
gate_waiter='[ -p "$1" ] || exit 125; exec 4<>"$1" 3<"$1" 4>&-
[ -p "$1" ] && IFS= read -r go <&3 && [ "$go" = go ] || exit 125
exec 3<&-; exec sh -c "$2"'

stop_session() {
    trap '' TERM INT HUP
    rm -f "$run_dir/next"
    if [ -n "$child_scope" ]; then
        session_log 'Stopping session during a game'
        # A gate still closed now never opens: the game cannot start, even if
        # systemd registers the scope after the stop below found nothing.
        exec 9>&-
        [ -z "$gate" ] || rm -f "$gate"
        # Worst case, every bound reached: 3.2 s save-exit + 1 s for runemu
        # + 1.4 s scope stop = 5.6 s (TimeoutStopSec=8).
        # Only a runemu that has not returned yet has a game to save.
        if [ "$game_started" -eq 1 ] && kill -0 "$child_pid" 2>/dev/null &&
            [ -x "$save_exit" ] && timeout -k 0.2 3 "$save_exit" suspend; then
            remaining=10
            while kill -0 "$child_pid" 2>/dev/null && [ "$remaining" -gt 0 ]; do
                "$stop_sleep" 0.1
                remaining=$((remaining - 1))
            done
        fi
        # save-exit finds the emulator through the kill file; keep it until now.
        rm -f "$kill_file"
        stop_scope "$child_scope"
    else
        rm -f "$kill_file"
        session_log 'Stopping launcher session'
        if [ -n "$child_pid" ]; then
            kill -TERM "$child_pid" 2>/dev/null || :
            if kill -0 "$child_pid" 2>/dev/null; then
                "$stop_sleep" 0.2
                if kill -0 "$child_pid" 2>/dev/null; then
                    kill -KILL "$child_pid" 2>/dev/null || :
                fi
            fi
            wait "$child_pid" 2>/dev/null
        fi
    fi
    # Never wait for a game: if its scope could not be stopped, the next
    # session start stops it, and this stop stays within its bound.
    exit 0
}

request_stop() {
    stop_pending=1
    [ "$defer_stop" -eq 1 ] || stop_session
}
trap request_stop TERM INT HUP

# Match start_es.sh: Wayland socket AND an active output, 100 ms, at most 10 s.
i=0
while [ "$i" -lt "$sway_attempts" ]; do
    sock=
    for candidate in "$XDG_RUNTIME_DIR"/sway-ipc.*.sock; do
        if [ -S "$candidate" ]; then
            sock=$candidate
            break
        fi
    done
    if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && [ -n "$sock" ] &&
        swaymsg -s "$sock" -t get_outputs 2>/dev/null | grep -q '"active": true'; then
        break
    fi
    "$sleep_bin" 0.1
    i=$((i + 1))
done
# The packaged sway config defaults to US. Restore the persisted choice after
# the compositor is ready, without depending on any EmulationStation files.
if command -v archr-keyboard >/dev/null 2>&1; then
    keyboard=$(archr-keyboard get 2>/dev/null || :)
    layout=${keyboard%% *}
    variant=${keyboard#* }
    if [ -n "$layout" ]; then
        # One transaction; clear the variant before the layout changes.
        sway_input="input * xkb_variant \"\"; input * xkb_layout $layout"
        [ -n "$variant" ] && sway_input="$sway_input; input * xkb_variant $variant"
        swaymsg "$sway_input" >/dev/null 2>&1 || :
    fi
fi
# A launcher module may cap the CPU for one game (runemu.sh --cpu-max=);
# runemu.sh lifts it on its way out, but not when it was killed. After every
# game the highest frequency comes back here: the boost ones only with
# boost on. Writing the same value again changes nothing.
restore_cpu_max() {
    boost=
    [ "$(cat "$cpufreq/boost" 2>/dev/null)" != 1 ] || boost=scaling_boost_frequencies
    for policy in "$cpufreq"/policy[0-9]*; do
        [ -w "$policy/scaling_max_freq" ] || continue
        top=$(cd "$policy" && cat scaling_available_frequencies $boost 2>/dev/null |
            tr ' ' '\n' | grep -E '^[0-9]+$' | sort -n | tail -n 1)
        [ -z "$top" ] || echo "$top" >"$policy/scaling_max_freq" 2>/dev/null || :
    done
}
# Also on any way out of the session, including a failed scope launch.
trap restore_cpu_max EXIT

# Games require systemd's system manager (this service runs as root). After
# SIGKILL/Restart=always, reclaim scopes the previous supervisor could not stop.
command -v systemd-run >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1 || exit 1
stale_scopes=$(timeout -k 1 5 systemctl list-units --all --plain --no-legend \
    'archr-game-*.scope') || exit 1
recovered_scope=0
for stale_scope in $(printf '%s\n' "$stale_scopes" | awk '{print $1}'); do
    case "$stale_scope" in
        archr-game-*.scope) stop_scope "$stale_scope"; recovered_scope=1 ;;
    esac
done
[ "$recovered_scope" -eq 0 ] || restore_cpu_max
# A gate of an earlier session that runs late finds no FIFO and exits.
rm -f "$run_dir"/game-gate* || exit 1
# /run survives service restarts, not reboots (when all old scopes are gone).
game_sequence=0
if [ -f "$run_dir/scope-sequence" ]; then
    read -r game_sequence <"$run_dir/scope-sequence" || exit 1
fi
case "$game_sequence" in ''|*[!0-9]*) exit 1 ;; esac

session_log 'Starting launcher session'

# Seen once after a GPU driver switch (R36S, 2026-11-12): sway up, its
# output never active, the launcher failing every second with "The video
# driver did not add any displays" until sway was restarted. Every 10th
# failure in a row with no active output: say what sway reports and ask it
# to bring its outputs up. When that has not helped by the 20th (a user's
# R36S Soysauce, 2026-11-13: 30 failures, then a forced power-off), restart
# sway; this unit Requires it, so systemd restarts the session with it.
failures=0

while :; do
    cap_log
    # input_sense uses killall with this file, never a PID or a process group.
    # The launcher and supervisor have different names; do not target the latter.
    printf '%s\n' archr-launcher >"$kill_file"
    # A leftover belongs to an interrupted cycle, never the next invocation.
    rm -f "$run_dir/next" || exit 1
    defer_stop=1
    child_scope=
    "$launcher" &
    child_pid=$!
    defer_stop=0
    [ "$stop_pending" -eq 0 ] || stop_session
    wait "$child_pid"
    launcher_status=$?
    child_pid=
    cap_log
    if [ "$launcher_status" -ne 0 ]; then
        rm -f "$run_dir/next" || exit 1
        session_log "Launcher exited with $launcher_status; retrying in 1 s"
        failures=$((failures + 1))
        if [ $((failures % 10)) -eq 0 ] &&
            ! swaymsg -t get_outputs 2>/dev/null | grep -q '"active": true'; then
            session_log "No active output after $failures failures: $(swaymsg -t get_outputs 2>&1 |
                tr -d ' \n' | grep -o '"\(name\|active\|dpms\|power\)":[^,}]*' | tr '\n' ' ')"
            if [ "$failures" -lt 20 ]; then
                swaymsg 'output * enable; output * power on' >/dev/null 2>&1 || :
            else
                session_log "Restarting sway: its output did not come up"
                timeout -k 1 5 systemctl --no-block restart sway.service >/dev/null 2>&1 || :
            fi
        fi
        # A crash becomes an anonymous error report unless reports are off
        # (archr-error-report decides, and leaves out stops from outside).
        # In the background: the launcher comes back meanwhile.
        if [ -x "$error_report" ]; then
            nice -n 10 "$error_report" launcher "$launcher_status" >/dev/null 2>&1 </dev/null &
        fi
        "$sleep_bin" 1
        continue
    fi
    failures=0
    if [ ! -f "$run_dir/next" ]; then
        continue
    fi

    line=
    IFS= read -r line <"$run_dir/next"
    # Consume before executing, so a crash cannot replay a game.
    rm -f "$run_dir/next" || exit 1
    case "$line" in
        'game '*)
            command=${line#game }
            # runemu clears then sets the actual emulator target; its wrappers
            # may refine it (e.g. -9 mupen64plus). Never overwrite it mid-game.
            rm -f "$kill_file"
            session_log 'Starting game'
            game_sequence=$((game_sequence + 1))
            printf '%s\n' "$game_sequence" >"$run_dir/scope-sequence.tmp" &&
                mv -f "$run_dir/scope-sequence.tmp" "$run_dir/scope-sequence" || exit 1
            defer_stop=1
            game_started=0
            child_scope=archr-game-$game_sequence.scope
            # mkfifo fails on an existing name: a gate is never reused.
            gate=$run_dir/game-gate-$game_sequence
            mkfifo -m 0600 "$gate" && exec 9<>"$gate" || exit 1
            # --scope execs the gate synchronously, and the gate execs the
            # game: runemu keeps this PID and its environment. The gate gets
            # no copy of the session's descriptor, so it cannot hold itself open.
            systemd-run --scope --unit="$child_scope" --collect \
                -p TimeoutStopSec=1 -- sh -c "$gate_waiter" archr-game-gate \
                "$gate" "$command" 9>&- &
            child_pid=$!
            defer_stop=0
            [ "$stop_pending" -eq 0 ] || stop_session
            # Open the gate only inside a registered scope. Giving up is safe:
            # a closed gate never starts the game.
            tries=50
            until scope_active "$child_scope"; do
                tries=$((tries - 1))
                if [ "$tries" -eq 0 ] || ! kill -0 "$child_pid" 2>/dev/null; then
                    session_log 'Game scope was not registered; not starting'
                    break
                fi
                "$stop_sleep" 0.1
            done
            defer_stop=1
            if [ "$tries" -gt 0 ] && kill -0 "$child_pid" 2>/dev/null; then
                game_started=1
                # Stays open until the game ends: closing it before the gate
                # has read would discard the "go".
                printf 'go\n' >&9
            fi
            defer_stop=0
            [ "$stop_pending" -eq 0 ] || stop_session
            # Never wait on a launch that was not let through: systemd-run may
            # stay blocked on the manager, and with its gate gone it can only
            # exit. The shell reaps it in the background; nothing waits on it.
            game_status=125
            if [ "$game_started" -eq 1 ]; then
                wait "$child_pid"
                game_status=$?
            fi
            exec 9>&-
            rm -f "$gate"
            gate=
            # runemu has returned: a TERM now must not ask for another save.
            defer_stop=1
            stop_scope "$child_scope"
            child_pid=
            child_scope=
            game_started=0
            defer_stop=0
            [ "$stop_pending" -eq 0 ] || stop_session
            session_log "Game exited with $game_status"
            restore_cpu_max
            printf '%s\n' "$game_status" >"$run_dir/last-exit.tmp" &&
                mv -f "$run_dir/last-exit.tmp" "$run_dir/last-exit" || exit 1
            ;;
        *) session_log 'Unknown instruction; ignoring' ;;
    esac
done
