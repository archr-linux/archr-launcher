[Unit]
Description=ArchR launcher session with Sway
Requires=sway.service
After=sway.service
RequiresMountsFor=/storage
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=HOME=/storage
EnvironmentFile=/etc/profile
ExecStart=/usr/bin/archr-launcher-session
WorkingDirectory=/storage
Restart=always
RestartSec=1
# TERM reaches only the supervisor; it preserves runemu.sh during cleanup.
# After TimeoutStopSec, systemd still KILLs the entire cgroup as a final guard.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=6

[Install]
WantedBy=archr.target
